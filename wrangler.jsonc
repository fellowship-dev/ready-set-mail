{
	// Shared configuration for every installation. Do not put your own ids or origin here:
	// `npm run setup` creates the resources and writes them to the git-ignored wrangler.local.jsonc,
	// which `npm run deploy`, `npm run migrate` and `npm run wrangler` use. The REPLACE_WITH_… ids below
	// make a deploy from this file alone fail instead of binding someone else's resources.
	// Install guide, token permissions and the manual path: docs/self-hosting.md.

	"name": "ready-set-mail-worker",
	"main": "src/index.ts",
	"build": {
		"command": "npm run build:dashboard"
	},
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/oauth/*", "/.well-known/*", "/health", "/llms.txt"]
	},
	"compatibility_date": "2025-03-01",
	// Set explicitly so Wrangler's defaults never decide: the Worker answers at https://<name>.<your-subdomain>.workers.dev,
	// and per-version preview URLs are off (an installation serves one origin, its BETTER_AUTH_URL).
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "invocation_logs": false }
	},

	// Installation-owned namespace (agent OAuth storage). `npm run setup` creates it; manual path: docs/self-hosting.md.
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_INSTALLATION_OAUTH_KV_ID" }],
	// Never reuse another instance's namespace.

	// D1 database binding. `npm run setup` creates this installation's own database; the placeholder makes a deploy
	// or remote migration from this file fail instead of binding someone else's database.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ready-set-mail",
			"database_id": "REPLACE_WITH_INSTALLATION_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],

	// Inbound email (DMARC reports, free checks) needs no setting here: the Worker exports an email() handler,
	// and the Email Routing rule the setup wizard creates sends mail to it.

	// Outbound email — requires CF Email Routing enabled on your zone.
	// Recipients must be verified destination addresses in CF Email Routing.
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],

	// Custom domain route — optional, add if you want a vanity URL instead of workers.dev
	// "routes": [
	// 	{ "pattern": "mail.yourdomain.com/*", "zone_name": "yourdomain.com" }
	// ],

	// Rate limiting
	"unsafe": {
		"bindings": [
			{ "name": "AUTH_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 10,  "period": 60 } },
			{ "name": "API_LIMITER",  "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 200, "period": 60 } },
			{ "name": "DNS_PREVIEW_LIMITER", "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
			// Agent requests per connection (src/mcp/rate-limit.ts). Half of API_LIMITER, which counts per workspace, so one agent cannot starve the rest.
			{ "name": "MCP_LIMITER",  "type": "ratelimit", "namespace_id": "1004", "simple": { "limit": 100, "period": 60 } },
			// Per IP, before any agent identity: token requests (assistants refresh from shared cloud addresses) and /mcp without a token.
			// /oauth/register uses AUTH_LIMITER on its own key. A presented token that fails is never limited per IP.
			{ "name": "OAUTH_TOKEN_LIMITER", "type": "ratelimit", "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } },
			{ "name": "MCP_ANON_LIMITER",    "type": "ratelimit", "namespace_id": "1006", "simple": { "limit": 60,  "period": 60 } }
		]
	},

	// Crons (what each does: docs/self-hosting.md#scheduled-jobs):
	//   0 8 * * *  — daily DNS monitor check
	//   0 9 * * 1  — weekly DMARC digest email (Mondays 9am UTC)
	//   0 10 * * * — daily SPF flatten refresh
	//   0 11 * * * — daily telemetry heartbeat (opt-in)
	//   0 4 * * *  — daily data lifecycle: retry Cloudflare revocations, then retention sweeps (own invocation: src/cron.ts)
	"triggers": {
		"crons": ["0 8 * * *", "0 9 * * 1", "0 10 * * *", "0 11 * * *", "0 4 * * *"]
	},

	// Email funnel (docs/email-funnel.md), all optional: RESEND_API_KEY (secret), AUTHSERV_ID, AUTHSERV_HEADER, MAIL_FROM, MAIL_REPLY_TO,
	// PUBLIC_BASE_URL, POSTAL_ADDRESS, BOOKING_URL, SERVICE_PRICES, SITE_ORIGINS, ONBOARDING_SEQUENCE_ENABLED.

	// Hosted service only (MODE=saas + SAAS_ENABLED=1, see docs/hosted.md): INTAKE_DOMAIN, CANARY_DOMAIN,
	// HOSTED_RECORDS_ZONE, HOSTED_RECORDS_LABEL, and the secret HOSTED_RECORDS_TOKEN. Self-hosters ignore these.
	// Hosted plan caps (positive integers, anything else keeps the default; never applied when self-hosting):
	//   MAX_WORKSPACES_PER_USER    workspaces one person may own (default 5; workspaces they were only invited to do not count)
	//   MAX_DOMAINS_PER_WORKSPACE  domains one workspace may hold (default 10)
	// A refused request answers 403 with code "plan_limit"; BOOKING_URL (https only) is offered as the way to ask for more.

	// Hosted intake: three tiers (docs/hosted.md). A report is COUNTED only when the receiving mail server authenticated the sender (AUTHSERV_ID +
	// AUTHSERV_HEADER; nothing is authenticated until both are set, and the Worker logs the authserv-id it sees: {"evt":"intake_authserv"}) AND the sender is in
	// the known-reporter registry (src/dmarc/known-reporters.ts; extend with INTAKE_KNOWN_REPORTERS, switch entries off with INTAKE_KNOWN_REPORTERS_DISABLE).
	// Authenticated senders not in the registry, and unauthenticated mail, are stored with tight caps and never counted. REPORT_COUNTING
	// (registry | authenticated | all; hosted default registry, self-host all). Caps: INTAKE_MAX_* (per address / workspace / instance, INTAKE_MAX_UNKNOWN_*,
	// INTAKE_MAX_UNAUTH_*, INTAKE_MAX_NONREGISTRY_DECOMPRESSED_BYTES, INTAKE_MAX_RECORDS_PER_REPORT 2000, INTAKE_MAX_DECOMPRESSED_BYTES 1 MiB,
	// INTAKE_MAX_RAW_BYTES 2 MiB: measured under wrangler dev). RETENTION_UNCOUNTED_REPORTS_DAYS (default 30; unknown and unauthenticated reports) is swept by the one daily cron. Uncounted reports have their own, much smaller storage budgets (INTAKE_MAX_UNCOUNTED_*), so strangers cannot use up room a known reporter needs. Expected AUTHSERV_ID=mx.cloudflare.net, AUTHSERV_HEADER=ar per Cloudflare's documentation: confirm on a message you sent yourself.
	// CPU: the worst measured report (docs/hosted.md, "Measured limits") takes ~0.5 s of CPU and ~77 MB of memory. Recommended: "limits": { "cpu_ms": 5000 }
	// (ten times the worst case; the Workers Paid default is 30000). Hosted intake needs Workers Paid: the Free plan's 10 ms CPU and 50 D1 queries cannot take a report.

	// Environment variables
	"vars": {
		"WORKER_NAME": "ready-set-mail-worker"
		// Domain config is entered in the setup wizard and stored in D1.
		// Installer proof secret: BOOTSTRAP_SECRET; agent issuer: BETTER_AUTH_URL + OAUTH_KV.
		// Optional DNS/routing secret: CLOUDFLARE_API_TOKEN (permissions: docs/self-hosting.md#permissions); or connect
		// Cloudflare from the dashboard instead (needs the TOKEN_ENCRYPTION_KEY secret, which `npm run setup` sets).
		// Optional HOSTED_SERVICE_URL (https): the hosted free tier. When set, /llms.txt, the MCP instructions, the
		// setup pages and /api/version mention it once; unset, nothing mentions a hosted service (src/hosted-service.ts).
	}
}
