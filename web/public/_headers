# Workers Static Assets reads this file from the assets directory (web/dist).
# Hashed build output never changes under the same name; the HTML shell must always be revalidated. Every path that is not
# a hashed asset or a font can answer with the HTML shell (single-page-application fallback), so no-cache applies to /* and
# the two asset folders detach it first.
# no-transform: stops Cloudflare injecting its Web Analytics beacon, which the CSP would block.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=63072000
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: no-cache, no-transform

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Fixed-name Geist files for the Worker's server-rendered agent pages (web/vite.config.ts). The name does not change
# with the content, so no `immutable`; a Geist upgrade reaches browsers within 30 days.
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
