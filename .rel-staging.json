{
  "name": "inbox-angel-launch-worker",
  "account_id": "f8a1abc24625b0ca9f9e34d87395c67c",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/.well-known/*",
      "/health",
      "/llms.txt",
      "/relay/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "51ed225c3ba449ad8a8cefbf89ad7185"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inbox-angel-launch",
      "database_id": "2bda3efd-7c4e-4fa4-bef0-7ccd164c51e7",
      "migrations_dir": "migrations"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "AUTH_LIMITER",
        "type": "ratelimit",
        "namespace_id": "731001",
        "simple": {
          "limit": 10,
          "period": 60
        }
      },
      {
        "name": "API_LIMITER",
        "type": "ratelimit",
        "namespace_id": "731002",
        "simple": {
          "limit": 200,
          "period": 60
        }
      },
      {
        "name": "DNS_PREVIEW_LIMITER",
        "type": "ratelimit",
        "namespace_id": "731003",
        "simple": {
          "limit": 10,
          "period": 60
        }
      },
      {
        "name": "MCP_LIMITER",
        "type": "ratelimit",
        "namespace_id": "731004",
        "simple": {
          "limit": 100,
          "period": 60
        }
      },
      {
        "name": "OAUTH_TOKEN_LIMITER",
        "type": "ratelimit",
        "namespace_id": "731005",
        "simple": {
          "limit": 600,
          "period": 60
        }
      },
      {
        "name": "MCP_ANON_LIMITER",
        "type": "ratelimit",
        "namespace_id": "731006",
        "simple": {
          "limit": 60,
          "period": 60
        }
      }
    ]
  },
  "triggers": {
    "crons": []
  },
  "vars": {
    "WORKER_NAME": "inbox-angel-launch-worker",
    "MODE": "selfhost",
    "OWNER_EMAIL": "maxfindel@pm.me",
    "ONBOARDING_SEQUENCE_ENABLED": "0",
    "BETTER_AUTH_URL": "https://inbox-angel-launch-worker.fellowshipdev.workers.dev"
  }
}