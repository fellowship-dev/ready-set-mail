{
 "name": "ready-set-mail-app",
 "account_id": "f8a1abc24625b0ca9f9e34d87395c67c",
 "main": "src/index.ts",
 "compatibility_date": "2025-03-01",
 "compatibility_flags": [
  "nodejs_compat",
  "global_fetch_strictly_public"
 ],
 "workers_dev": true,
 "preview_urls": false,
 "assets": {
  "directory": "./web/dist",
  "binding": "ASSETS",
  "not_found_handling": "single-page-application",
  "run_worker_first": [
   "/api/*",
   "/mcp",
   "/mcp/*",
   "/oauth/*",
   "/.well-known/*",
   "/health",
   "/llms.txt",
   "/relay/*"
  ]
 },
 "observability": {
  "enabled": true,
  "logs": {
   "enabled": true,
   "invocation_logs": false
  }
 },
 "kv_namespaces": [
  {
   "binding": "OAUTH_KV",
   "id": "c76d33f603574a398352cd055d2f85fb"
  }
 ],
 "d1_databases": [
  {
   "binding": "DB",
   "database_name": "ready-set-mail-app",
   "database_id": "b6fdd04b-d7fd-4988-b644-1acace7a2238",
   "migrations_dir": "migrations"
  }
 ],
 "unsafe": {
  "bindings": [
   {
    "name": "AUTH_LIMITER",
    "type": "ratelimit",
    "namespace_id": "751001",
    "simple": {
     "limit": 10,
     "period": 60
    }
   },
   {
    "name": "API_LIMITER",
    "type": "ratelimit",
    "namespace_id": "751002",
    "simple": {
     "limit": 200,
     "period": 60
    }
   },
   {
    "name": "DNS_PREVIEW_LIMITER",
    "type": "ratelimit",
    "namespace_id": "751003",
    "simple": {
     "limit": 10,
     "period": 60
    }
   },
   {
    "name": "MCP_LIMITER",
    "type": "ratelimit",
    "namespace_id": "751004",
    "simple": {
     "limit": 100,
     "period": 60
    }
   },
   {
    "name": "OAUTH_TOKEN_LIMITER",
    "type": "ratelimit",
    "namespace_id": "751005",
    "simple": {
     "limit": 600,
     "period": 60
    }
   },
   {
    "name": "MCP_ANON_LIMITER",
    "type": "ratelimit",
    "namespace_id": "751006",
    "simple": {
     "limit": 60,
     "period": 60
    }
   }
  ]
 },
 "triggers": {
  "crons": []
 },
 "vars": {
  "WORKER_NAME": "ready-set-mail-app",
  "MODE": "saas",
  "SAAS_ENABLED": "1",
  "MAX_WORKSPACES_PER_USER": "5",
  "MAX_DOMAINS_PER_WORKSPACE": "10",
  "ONBOARDING_SEQUENCE_ENABLED": "0",
  "BETTER_AUTH_URL": "https://app.readysetmail.com",
  "OWNER_EMAIL": "hello@readysetmail.com",
  "BOOKING_URL": "https://tidycal.com/maxfindel/spam-phishing-and-deliverability-audit",
  "TURNSTILE_SITE_KEY": "0x4AAAAAAGAP3TAJaqXtdjx4",
  "CF_OAUTH_CLIENT_ID": "62d74e99d4e79e555d1249a0563cc67c",
  "CF_OAUTH_AUTHORIZE_URL": "https://dash.cloudflare.com/oauth2/auth",
  "CF_OAUTH_TOKEN_URL": "https://dash.cloudflare.com/oauth2/token",
  "CF_OAUTH_REVOKE_URL": "https://dash.cloudflare.com/oauth2/revoke",
  "CF_OAUTH_SCOPES": "zone.read dns.write account-settings.read offline_access",
  "INTAKE_DOMAIN": "rua.readysetmail.com"
 },
 "routes": [
  {
   "pattern": "app.readysetmail.com",
   "custom_domain": true
  }
 ],
 "send_email": [
  {
   "name": "SEND_EMAIL"
  }
 ]
}