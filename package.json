{
  "name": "ready-set-mail-worker",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "deploy": "npm run build:dashboard && npm run migrate && node scripts/wrangler.mjs deploy",
    "wrangler": "node scripts/wrangler.mjs",
    "migrate": "node packages/db/scripts/migrate.mjs --remote",
    "dev": "npm run migrate:local && wrangler dev",
    "dev:dashboard": "npm --prefix web run dev",
    "build:dashboard": "npm run build -w @ready-set-mail/ui && npm run build -w @ready-set-mail/web",
    "start": "wrangler dev",
    "test": "vitest --config vitest.node.config.mts",
    "test:ui": "npm test --workspace @ready-set-mail/ui",
    "test:web": "npm run build -w @ready-set-mail/ui && npm test -w @ready-set-mail/web",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "seed:local": "npx tsx scripts/seed-demo.ts > /tmp/ia-seed.sql && wrangler d1 execute ready-set-mail --local  --file=/tmp/ia-seed.sql; rm -f /tmp/ia-seed.sql",
    "seed:remote": "npx tsx scripts/seed-demo.ts > /tmp/ia-seed.sql && node scripts/wrangler.mjs d1 execute DB --remote --file=/tmp/ia-seed.sql; rm -f /tmp/ia-seed.sql",
    "unseed:local": "wrangler d1 execute ready-set-mail --local  --file=scripts/unseed-demo.sql",
    "unseed:remote": "node scripts/wrangler.mjs d1 execute DB --remote --file=scripts/unseed-demo.sql",
    "typecheck": "tsc --noEmit && tsc -p packages/dns-checks && tsc -p packages/report && tsc -p packages/db && tsc -p web",
    "migrate:local": "node packages/db/scripts/migrate.mjs --local",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.6",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@playwright/test": "^1.64.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.160.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@ready-set-mail/dns-checks": "*",
    "@ready-set-mail/report": "*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "^1.7.12",
    "fast-xml-parser": "^5.7.2",
    "fflate": "^0.8.3",
    "mimetext": "^3.0.28",
    "tldts": "^7.4.19",
    "zod": "4.6.7"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "web"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
